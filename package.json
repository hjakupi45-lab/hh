{
  "name": "electron-by-haris",
  "productName": "Electron by Haris",
  "version": "1.0.0",
  "description": "Electron by Haris - High Performance Download Manager",
  "main": "app/main.js",
  "scripts": {
    "start": "electron app/main.js",
    "dev": "electron app/main.js",
    "generate-icons": "node scripts/generate-icons.js",
    "build:extensions": "node scripts/build-extensions.js",
    "test:scheduler": "node scripts/test-scheduler.js",
    "pack": "npm run build:extensions && electron-builder --dir",
    "dist": "npm run build:extensions && electron-builder --win nsis",
    "dist:win": "npm run build:extensions && electron-builder --win nsis",
    "dist:mac": "npm run build:extensions && electron-builder --mac",
    "dist:all": "npm run build:extensions && electron-builder --win nsis && electron-builder --mac"
  },
  "build": {
    "appId": "com.haris.electronbyharis",
    "productName": "Electron by Haris",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/extensions/firefox",
        "to": "extension-firefox",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/ui/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Electron by Haris",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "app/ui/assets/icon.png"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "keywords": [
    "download-manager",
    "idm",
    "segmented-download",
    "electron"
  ],
  "author": "Haris",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "uuid": "^14.0.3",
    "ws": "^8.22.0"
  }
}
