{
  "name": "electron-by-haris",
  "productName": "Electron by Haris",
  "version": "1.0.0",
  "description": "Electron by Haris - High Performance Download Manager",
  "main": "app/main.js",
  "scripts": {
    "start": "electron app/main.js",
    "dev": "electron app/main.js",
    "generate-icons": "node scripts/generate-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.haris.electronbyharis",
    "productName": "Electron by Haris",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/ui/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Electron by Haris",
      "runAfterFinish": true
    }
  },
  "keywords": [
    "download-manager",
    "idm",
    "segmented-download",
    "electron"
  ],
  "author": "Haris",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "uuid": "^14.0.3",
    "ws": "^8.22.0"
  }
}
