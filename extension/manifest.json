{
  "manifest_version": 3,
  "name": "Electron by Haris - Download Integration",
  "short_name": "Electron by Haris",
  "version": "6.42.18",
  "description": "Electron by Haris integration module. Captures browser downloads and grabs web videos (Chrome, Edge, Brave, Opera, Firefox).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Electron by Haris"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["polyfill.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
